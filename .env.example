# FindMaxxing environment. Copy to .env.local for development.
# Leave the Supabase pair empty to run in demo mode (local only: a production
# server refuses demo mode unless FINDMAXXING_ALLOW_DEMO_IN_PRODUCTION=1).

# --- Public (sent to the browser; safe to expose) --------------------------
# Required in production. Both set = Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute site origin: auth email links, the geocoder's User-Agent.
# Required in production (e.g. https://findmaxxing.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: a public pk.* token switches the map to Mapbox; without it the map
# uses MapLibre + OpenFreeMap (no key needed).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=

# --- Secret (server only; never prefix with NEXT_PUBLIC_) -------------------
# Required in production: account deletion calls the Auth admin API with it.
# Also used by scripts/migrate-images.ts. It bypasses RLS: keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=
# Optional error reporting (see src/lib/observability). Either or both.
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# --- Part B features (all off unless listed; "all" switches every one on) --
# e.g. analytics,reputation,admin,recommendations,messaging,notifications,ads,pwa
NEXT_PUBLIC_FEATURES=
# Vercel Cron sends this as a bearer token to /api/cron/* (secret).
CRON_SECRET=
# Optional copies of analytics events (off by default; secret).
POSTHOG_KEY=
POSTHOG_HOST=
ANALYTICS_FORWARD_SECRET=
PLAUSIBLE_DOMAIN=

# AI features (aiRerank, tripPlanning). Server-only secret.
ANTHROPIC_API_KEY=
# Model for the "For you" rerank (default claude-sonnet-5).
RECOMMENDATIONS_MODEL=

# --- Demo mode only ---------------------------------------------------------
# 1 = never write .data/demo-store.json (scripted browser runs, tests).
FINDMAXXING_DEMO_NO_PERSIST=
# 1 = allow `next start` in demo mode with NODE_ENV=production (a public demo).
FINDMAXXING_ALLOW_DEMO_IN_PRODUCTION=
